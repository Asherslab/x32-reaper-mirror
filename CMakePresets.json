{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 19, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-x64",
      "inherits": "base",
      "displayName": "Linux x64",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "macos-universal",
      "inherits": "base",
      "displayName": "macOS universal",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "x86_64;arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "10.14"
      }
    },
    {
      "name": "win-x64",
      "inherits": "base",
      "displayName": "Windows x64 (MSVC)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/win-x64",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "core-only",
      "inherits": "base",
      "displayName": "Protocol core + tests only (no REAPER SDK)",
      "cacheVariables": { "X32MIRROR_BUILD_REAPER": "OFF" }
    }
  ],
  "buildPresets": [
    { "name": "linux-x64", "configurePreset": "linux-x64" },
    { "name": "macos-universal", "configurePreset": "macos-universal" },
    { "name": "win-x64", "configurePreset": "win-x64" },
    { "name": "core-only", "configurePreset": "core-only" }
  ],
  "testPresets": [
    { "name": "linux-x64", "configurePreset": "linux-x64", "output": { "outputOnFailure": true } },
    { "name": "core-only", "configurePreset": "core-only", "output": { "outputOnFailure": true } }
  ]
}
